# Render API key for scripts/render_deploy.py
#
# Copy this file to scripts/.env and fill it in. scripts/.env is gitignored.
#
# Create the key at https://dashboard.render.com/u/settings#api-keys
# It is account-wide: it can create and delete every service in the account.
#
# Lookup order: RENDER_API_KEY env var -> scripts/.env -> scripts/.env.deploy
#               -> ~/.render-api-key
RENDER_API_KEY=rnd_your_key_here

# Hugging Face write token (no card): https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here
