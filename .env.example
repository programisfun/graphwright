# graphwright settings (copy to .env; .env is gitignored)

# --- Local Neo4j started by docker-compose.yml ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphwright
NEO4J_DATABASE=neo4j

# --- MCP server ---
# streamable-http | stdio
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Require Authorization: Bearer <token> on every request. Empty = no auth, which is
# fine on loopback and required to be set on any public host.
# MCP_AUTH_TOKEN=

# --- Neo4j AuraDB Free (uncomment to use, then drop the compose neo4j service) ---
# NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<aura-password>
# NEO4J_DATABASE=neo4j
