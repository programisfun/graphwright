# graphwright settings (copy to .env; .env is gitignored)

# --- Neo4j (AuraDB Free shown; any Bolt endpoint works) ---
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=<username>          # Aura instances often use the instance id here
NEO4J_PASSWORD=<password>
NEO4J_DATABASE=<database>

# --- MCP server ---
# streamable-http | stdio
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Self-contained requests: no in-memory sessions, no instance affinity. Set to 1 on
# any host that scales to zero or redeploys (Render, Cloud Run). Off locally is fine.
# MCP_STATELESS=1

# --- Auth: one admin token, all tools, destructive allowed ---
# Required. Every request must send   Authorization: Bearer <token>   (/health stays
# public). The server refuses to start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=<your-token>
