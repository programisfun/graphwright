# graphwright settings (copy to .env; .env is gitignored)

# --- Neo4j (AuraDB Free shown; any Bolt endpoint works) ---
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=<username>          # Aura instances often use the instance id here
NEO4J_PASSWORD=<password>
NEO4J_DATABASE=<database>

# --- MCP server ---
# streamable-http | stdio
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000

# --- Auth: one admin token, all tools, destructive allowed ---
# Set this on any host reachable from outside this machine. Every request must then
# send   Authorization: Bearer <token>   and /health stays public.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave commented out for loopback-only use; compose then sets MCP_ALLOW_INSECURE=1.
# MCP_AUTH_TOKEN=

# Only needed when no token is set and the server binds a non-loopback host,
# e.g. a container published on 127.0.0.1. Never set this on a public host.
# MCP_ALLOW_INSECURE=1
